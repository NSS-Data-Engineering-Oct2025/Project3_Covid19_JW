),

joined as (
    select
        c.county_fips,
        c.state_fips,
        c.case_month,
        c.total_cases,
        c.total_deaths,
        c.total_hospitalizations,
        p.county_name,
        p.population
    from cases c
    left join population p
        on c.county_fips = p.county_fips
)

select * from joined
  )
