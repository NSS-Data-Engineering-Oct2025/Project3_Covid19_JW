[0m19:21:06.577103 [debug] [Thread-2 (]: On model.covid_pipeline.stg_covid_cases: create or replace   view COVID_DB.STAGING.stg_covid_cases
  
  
  
  
  as (
    -- Staging: CDC COVID-19 cases
-- Light cleaning only — no business logic here.
-- One row per case record from the CDC SODA API.

with source as (
    select * from COVID_DB.RAW.raw_covid_cases
),

cleaned as (
    select
        -- Build a 5-digit FIPS key for joining
        lpad(state_fips_code, 2, '0') || lpad(county_fips_code, 3, '0') as county_fips,
        lpad(state_fips_code, 2, '0')                                    as state_fips,

        -- Normalize month to a proper date (first day of the month)
        try_to_date(case_month, 'YYYY-MM')                               as case_month,

        -- Demographic fields
        nullif(trim(age_group), '')    as age_group,
        nullif(trim(sex), '')          as sex,
        nullif(trim(race), '')         as race,
        nullif(trim(ethnicity), '')    as ethnicity,

        -- Outcome fields
        nullif(trim(outcome), '')         as outcome,
        nullif(trim(hospitalization), '') as hospitalization,

        -- Derived flags for easier aggregation
        case when lower(outcome) = 'death' then 1 else 0 end         as is_death,
        case when lower(hospitalization) = 'yes' then 1 else 0 end   as is_hospitalized,

        current_timestamp() as _loaded_at

    from source
    where state_fips_code is not null
      and case_month is not null
)

select * from cleaned
  )
/* {"app": "dbt", "dbt_version": "1.11.7", "profile_name": "covid_pipeline", "target_name": "dev", "node_id": "model.covid_pipeline.stg_covid_cases"} */;
[0m19:21:06.578023 [debug] [Thread-4 (]: On model.covid_pipeline.stg_vaccinations: create or replace   view COVID_DB.STAGING.stg_vaccinations
  
  
  
  
  as (
    -- Staging: CDC COVID-19 vaccinations by county
-- Light cleaning only — cast types, normalize FIPS, drop junk rows.

with source as (
    select * from COVID_DB.RAW.raw_vaccinations
),

cleaned as (
    select
        lpad(fips, 5, '0')                    as county_fips,
        nullif(trim(recip_county), '')         as county_name,
        upper(trim(recip_state))               as state_abbrev,
        try_to_date(date)                      as vaccination_date,

        try_to_number(administered_dose1_recip)  as dose1_cumulative,
        try_to_number(series_complete_yes)        as series_complete_cumulative,
        try_to_number(booster_doses)              as booster_cumulative,
        try_to_number(census2019)                 as census2019_pop,

        current_timestamp() as _loaded_at

    from source
    where fips is not null
      and fips not in ('UNK', 'UNKNOWN', '')
      and date is not null
)

select * from cleaned
  )
